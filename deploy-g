@echo off
echo ========================================
echo 2026春节倒计时 - GitHub Pages 部署脚本
echo ========================================
echo.

echo 步骤 1: 配置 Git 远程仓库
echo.
echo 请先在 GitHub 上创建一个新仓库，然后执行：
echo git remote add origin https://github.com/你的用户名/仓库名.git
echo.
set /p github_url="或者直接输入仓库URL (留空跳过): "

if not "%github_url%"=="" (
    git remote add origin %github_url%
    echo 已配置远程仓库: %github_url%
)

echo.
echo 步骤 2: 推送到 GitHub
echo.
git push -u origin main

if %ERRORLEVEL% EQU 0 (
    echo.
    echo 部署成功！
    echo.
    echo 接下来请在 GitHub 仓库设置中：
    echo 1. 进入 Settings -^> Pages
    echo 2. 选择 main 分支和 / 根目录
    echo 3. 点击 Save
    echo.
    echo 您的网站将在几分钟内可用
) else (
    echo.
    echo 推送失败，请检查：
    echo - 是否已配置远程仓库
    echo - 是否有 GitHub 访问权限
    echo - 网络连接是否正常
)

echo.
pause